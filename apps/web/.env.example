# Sao chép tệp này thành ".env" (hoặc ".env.local") rồi điền giá trị thật.
# Không đặt VITE_PDF_SERVER_URL — mục "Tải PDF (chữ thật)" tự ẩn, app vẫn
# chạy bình thường với bản PDF ảnh + In… → Save as PDF (P5-friendly).

# URL endpoint của @scirender/pdf-server, xem packages/pdf-server/README.md
# để chạy local hoặc triển khai (render.yaml ở gốc kho).
VITE_PDF_SERVER_URL=http://localhost:8787/export-pdf

# Chỉ cần nếu máy chủ đặt biến EXPORT_TOKEN — phải khớp giá trị đó.
VITE_PDF_SERVER_TOKEN=
