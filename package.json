{
  "name": "scirender",
  "version": "2.0.0",
  "private": true,
  "description": "SciRender — Scientific Document Intelligence Studio. Write science once. Render it professionally everywhere.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "pnpm --filter @scirender/web dev",
    "build": "pnpm --filter @scirender/web build",
    "preview": "pnpm --filter @scirender/web preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @scirender/pdf-server typecheck",
    "clean": "pnpm -r exec node -e \"const fs=require('fs');for(const p of ['node_modules','dist'])fs.rmSync(p,{recursive:true,force:true})\" && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "smoke": "node scripts/run-smoke.mjs",
    "smoke:root-cause": "node scripts/smoke-root-cause-v3.mjs",
    "browser-check": "node scripts/browser-check.mjs",
    "fonts": "node scripts/sync-fonts.mjs",
    "smoke:round2": "node scripts/smoke-round2.mjs",
    "smoke:round3": "node scripts/smoke-round3-runtime-contracts.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "playwright": "1.48.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18.18"
  }
}
